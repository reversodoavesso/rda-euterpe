# Chave da DeepSeek (obrigatória para o agente)
DEEPSEEK_API_KEY=
# Endpoint LLM (default DeepSeek; mude p/ testes/mock ou outro provider OpenAI-compatível)
# LLM_BASE_URL=https://api.deepseek.com

# Modelos (defaults)
LLM_CHAT_MODEL=deepseek-v4-flash
LLM_CURATION_MODEL=deepseek-v4-pro

# Roteamento automático por songchange (true/false)
# AUTO_ROUTING=false

# Servidor
HOST=127.0.0.1
PORT=8337

# Websearch (SearXNG local)
SEARXNG_URL=http://127.0.0.1:8888

# Similaridade (opcionais — sem chave, usa Spotify + Deezer)
LASTFM_API_KEY=
TASTEDIVE_API_KEY=

# Banco de dados local (opcional, default abaixo)
# DB_PATH=data/euterpe.db

# Quantos turnos de conversa passada enviar ao LLM (0 = sem histórico/stateless)
# CHAT_HISTORY=0

# Modo debug: true => detalhes técnicos (códigos de erro, nomes de tools) no chat
# EUTERPE_DEBUG=false
