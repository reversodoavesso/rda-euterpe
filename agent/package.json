{
  "name": "euterpe-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Euterpe - local Spotify agent (DeepSeek + tools)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/parse-suggestions.mjs && node --test tests/",
    "test:integration": "node tests/orchestrators.mjs && node tests/mutation-gate.mjs && node tests/agent-loop.mjs",
    "goldens": "tsc && node tools/export-goldens.mjs",
    "replay-corpus": "node tools/export-replay-corpus.mjs"
  },
  "dependencies": {
    "@fastify/websocket": "^8.3.1",
    "better-sqlite3": "^12",
    "dotenv": "^16.4.7",
    "fastify": "^4.29.0",
    "openai": "^4.77.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.19",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
